{
  "benchmark": {
    "name": "KuaiRand-Pure",
    "label": "long_view",
    "metrics": ["GAUC", "nDCG@5"],
    "primary": "mean(GAUC, nDCG@5)",
    "official_valid_primary": 0.6016,
    "incumbent_valid_primary_seed_0": 0.6038926243782043,
    "incumbent_valid_primary": 0.604539155960083,
    "incumbent_single_seed_primary": 0.60400390625,
    "incumbent_three_seed_mean": 0.6038278142611185,
    "incumbent_model": "five-seed within-user rank ensemble of four-negative BPR FM"
  },
  "paths": {
    "data_dir": "./KuaiRand-Pure/data",
    "runs_dir": "./runs",
    "candidate_dir": "./candidate"
  },
  "llm": {
    "provider": "soclaas",
    "model": "qwen3-coder-next",
    "planning_model": "qwen3.6:35b",
    "planning_max_tokens": 1800,
    "reflection_max_tokens": 900,
    "coding_max_tokens": 12000,
    "coding_compact_max_tokens": 6000,
    "temperature": 0.2,
    "request_timeout_seconds": 180,
    "max_attempts": 1
  },
  "budget": {
    "epsilon": 0.002,
    "consecutive_non_improving_iterations": 3,
    "max_iterations": 50,
    "max_wall_clock_seconds": 21600,
    "experiment_timeout_seconds": 1200,
    "max_repair_attempts": 1,
    "max_llm_tokens_per_iteration": 52000,
    "repair_token_reserve": 14000
  },
  "safety": {
    "development_splits": ["train", "valid"],
    "protected_files": [
      "evaluate.py",
      "data.py",
      "baseline.py",
      "submit.py"
    ],
    "mutable_roots": ["candidate"]
  }
}
